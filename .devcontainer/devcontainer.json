{
  "name": "MFIIDD",
  "build": { "dockerfile": "Dockerfile" },
  "onCreateCommand": "julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'",
  "updateContentCommand": "julia --project=. -e 'using MFIIDD; println(\"MFIIDD loads\")'",
  "customizations": {
    "vscode": {
      "extensions": [
        "julialang.language-julia",
        "quarto.quarto"
      ],
      "settings": {
        "julia.environmentPath": "${containerWorkspaceFolder}",
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "vscode"
}
